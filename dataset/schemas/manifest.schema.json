{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:boat-maintenance:v1.2:manifest",
  "type": "object",
  "required": [
    "format",
    "schema_version",
    "dataset_id",
    "vessel_id",
    "files"
  ],
  "properties": {
    "format": {
      "const": "boat-maintenance-data"
    },
    "schema_version": {
      "type": "string"
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "vessel_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string"
    },
    "modified_at": {
      "type": "string"
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "conventions": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
